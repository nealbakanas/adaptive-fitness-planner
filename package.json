{
  "name": "adaptive-fitness-planner",
  "private": true,
  "description": "The Android app (Capacitor) around the web app. The web app itself needs no build; see README → Android app.",
  "scripts": {
    "www": "node scripts/www.mjs",
    "native": "esbuild js/native-entry.js --bundle --format=esm --minify --legal-comments=none --outfile=vendor/capacitor/native.js",
    "sync": "npm run www && npx cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor-community/keep-awake": "8.0.1",
    "@capawesome-team/capacitor-android-foreground-service": "8.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "esbuild": "0.28.2"
  }
}
